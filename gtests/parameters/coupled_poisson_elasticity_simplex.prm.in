include @IMMERSX_BINARY_DIR@/gtests/parameters/coupled_poisson_elasticity.prm
subsection Poisson
  subsection Domain
    set Grid generator = @TEST_DATA_DIR@/tests/simplex_axial_line_3d.vtk
    set Initial refinement = 0
  end
end
subsection Elastic static
  set FE degree = 2
  set Output directory = @TEST_OUTPUT_DIR@/coupled-poisson-elasticity-simplex
  subsection Domain
    set Grid generator = @TEST_DATA_DIR@/tests/simplex_cube.msh
    set Initial refinement = 0
  end
end
subsection Pressure lift
  set Thickness = 0.1
end
