set dimension = 3
set space dimension = 3
set reduced dimension = 1
set cross section dimension = 2
subsection Reduced Poisson
  set Solver type = Schur
  set FE degree = 2
  set Dirichlet boundary ids = 0
  set Output directory = @TEST_OUTPUT_DIR@/reduced-poisson-simplex-line-3d
  set Output name = quadratic
  subsection Grid generation
    set Triangulation type = fullydistributed
    set Grid generator = @TEST_DATA_DIR@/tests/simplex_cube.msh
    set Initial refinement = 0
  end
  subsection Dirichlet boundary conditions
    set Variable names = x,y,z,t
    set Function expression = 1+x*x
  end
  subsection Right hand side
    set Variable names = x,y,z,t
    set Function expression = -2
  end
  subsection Solver
    subsection Inner control
      set Max steps = 1000
      set Tolerance = 1.e-13
      set Reduction = 1.e-13
    end
    subsection Outer control
      set Max steps = 1000
      set Tolerance = 1.e-13
      set Reduction = 1.e-13
    end
  end
end
subsection Tensor product coupling
  subsection Cross section
    set Inclusion type = hyper_cube
    set Maximum inclusion degree = 0
    set Selected indices = 0
    set Number of quadrature points = 3
    set Refinement level = 0
  end
  subsection Local refinement parameters
    set Refinement strategy = space
    set Refinement factor = 1
    set Max refinement level = 0
    set Space pre-refinement cycles = 0
    set Space post-refinement cycles = 0
    set Embedded pre-refinement cycles = 0
    set Embedded post-refinement cycles = 0
  end
  subsection Representative domain
    set Reduced grid name = @TEST_DATA_DIR@/tests/simplex_interior_line_3d.vtk
    set Reduced right hand side = 1+x*x
    set Thickness = 0.05
    set Finite element degree = 1
    set Quadrature type = gauss
    set Number of quadrature points = 3
  end
end
