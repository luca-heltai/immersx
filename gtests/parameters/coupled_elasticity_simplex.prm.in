set dimension = 3
set space dimension = 3
subsection Immersed Problem
  set FE degree = 2
  set Initial refinement = 0
  set Output directory = @TEST_OUTPUT_DIR@/coupled-elasticity-simplex
  set Dirichlet boundary ids = 0
  subsection Grid generation
    set Domain type = file
    set Triangulation type = fullydistributed
    set Grid generator = @TEST_DATA_DIR@/tests/simplex_cube.msh
  end
  subsection Refinement and remeshing
    set Number of refinement cycles = 1
  end
  subsection Immersed inclusions
    set Inclusions file = @TEST_DATA_DIR@/tests/simplex_tissue_vessel.txt
    set Inclusions refinement = 16
    set Number of fourier coefficients = 3
    set Selection of Fourier coefficients = 0,4
    set Reference inclusion data = 0,0,0,0,0,0,0,0,0
  end
  subsection Material properties
    subsection default
      set Lame mu = 1
      set Lame lambda = 1
    end
  end
end
subsection Solvers
  subsection Displacement
    set Max steps = 1000
    set Tolerance = 1.e-13
    set Reduction = 1.e-13
  end
  subsection Augmented Lagrange
    set Max steps = 1000
    set Tolerance = 1.e-13
    set Reduction = 1.e-13
  end
  subsection Reduced mass
    set Max steps = 1000
    set Tolerance = 1.e-13
    set Reduction = 1.e-13
  end
end
