subsection MetricFlowSystem<1, 3>
  set Wall model = ADAVN arterial
  set Viscoelastic wall = true
  set Terminal parameter source = VTK
  set Vtk file path for mesh input = @TEST_DATA_DIR@/metric_flow_x/viscoelastic_single_vessel.vtk
  set Finite element degree = 1
  set Number of global refinement = 0
  set Number of refinement cycles = 1
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-viscoelastic
end
