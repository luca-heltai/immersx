set dimension       = 2
set space dimension = 2

subsection Navier-Stokes
  set Output directory    = navier_stokes_app_output
  set Output name         = navier_stokes
  set Initial refinement  = 5
  set Dirichlet boundary ids = 0

  subsection Finite element spaces
    set Velocity degree = 2
    set Pressure degree = 1
  end

  subsection Grid generation
    set Grid generator           = hyper_cube
    set Grid generator arguments = 0: 1: true
  end

  subsection Physical properties
    set Density                 = 1
    set Viscosity               = 1
    set Include convective term = false
  end

  subsection Time parameters
    set Policy               = number_of_steps
    set Initial time         = 0
    set Final time           = 1
    set Number of time steps = 100
    set Output frequency    = 0
  end

  subsection Right hand side
    set Function expression = 0; 0; 0
    set Variable names      = x,y,t
  end

  subsection Dirichlet boundary conditions
    set Function expression = y>0.99  ? 1 : 0; 0; 0
    set Variable names      = x,y,t
  end

  subsection Initial condition
    set Function expression = y>0.99  ? 1 : 0; 0; 0
    set Variable names      = x,y,t
  end

  subsection Solver
    subsection Control
      set Max steps  = 300
      set Reduction  = 1.e-9
      set Tolerance  = 1.e-11
      set Log result = false
    end
    set Inner maximum steps = 300
    set Inner tolerance     = 1.e-10
    set Log iterations      = false
  end
end
