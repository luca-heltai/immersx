include @IMMERSX_BINARY_DIR@/gtests/parameters/metric_flow_x_elastodynamics.prm

subsection Elastodynamics
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-rcr
  subsection Domain
    set Grid generator = hyper_cube
    set Grid generator arguments = -0.2:0.2:false
    set Initial refinement = 2
  end
end

subsection MetricFlowSystem<1, 3>
  set Vtk file path for mesh input = @TEST_DATA_DIR@/tests/metric_flow_x_two_vessels_rcr.vtk
  set Number of global refinement = 0
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-rcr
  subsection IDA parameters
    set Final time = 0.002
    set Time interval between each output = 0.001
  end
end

subsection MetricFlowX coupling
  set Embedded partitioning policy = @PARTITIONING_POLICY@
end
