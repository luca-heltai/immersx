set dimension         = 2
set space dimension   = 2
set reduced dimension = 1

subsection Error
  set Enable computation of the errors = true
  set Error file name                  = @TEST_OUTPUT_DIR@/gtests/parameters/issue_209/elasticity/errors.txt
  set Error precision                  = 8
end

subsection Functions
  subsection Dirichlet boundary conditions
    set Function expression  = sin(2*pi*50*t); 0
    set Modulation frequency = 0
    set Phase shift          = 0
    set Variable names       = x,y,t
  end
end

subsection Immersed Problem
  set Dirichlet boundary ids             = 0
  set FE degree                          = 1
  set Initial refinement                 = 6
  set Neumann boundary ids               =
  set Normal flux boundary ids           =
  set Output directory                   = @TEST_OUTPUT_DIR@/gtests/parameters/issue_209/elasticity
  set Output name                        = solution_elasticity
  set Output pressure                    = false
  set Output results also before solving = false
  set Pressure coupling                  = false
  set Rhs material ids                   =
  set Coupling type                     =
  subsection Grid generation
    set Domain type              = generate
    set Grid generator           = hyper_cube
    set Grid generator arguments = 0:0.1:true
    set Grid scale               = 1.0
    set Triangulation type       = distributed
  end
  subsection Material properties
    set Material tags by material id =
    subsection default
      set Density        = 1000
      set Lame lambda    = 0
      set Lame mu        = 1000
      set Rayleigh alpha = 0
      set Rayleigh beta  = 0
      set Viscosity eta  = 25
    end
  end
  subsection Refinement and remeshing
    set Coarsening fraction         = 0
    set Maximum number of cells     = 20000
    set Number of refinement cycles = 1
    set Refinement fraction         = 0.3
    set Strategy                    = global
  end
  subsection Time parameters
    set Final time       = 0.02
    set Initial time     = 0
    set Newmark beta     = 0.25
    set Newmark gamma    = 0.5
    set Refine time step = false
    set Time step        = 0.0025
  end
end

subsection Solvers
  subsection Augmented Lagrange
    set Log history = false
    set Log result  = false
    set Max steps   = 1000
    set Reduction   = 1.e-14
    set Tolerance   = 1.e-14
  end
  subsection Displacement
    set Log history = false
    set Log result  = false
    set Max steps   = 1000
    set Reduction   = 1.e-14
    set Tolerance   = 1.e-14
  end
  subsection Reduced mass
    set Log history = false
    set Log result  = false
    set Max steps   = 1000
    set Reduction   = 1.e-14
    set Tolerance   = 1.e-14
  end
  subsection Schur complement
    set Log history = false
    set Log result  = false
    set Max steps   = 1000
    set Reduction   = 1.e-14
    set Tolerance   = 1.e-14
  end
end
