set dimension = 2
set space dimension = 2
subsection Fiber Reinforced Elasticity Frequency
  set Frequencies = 0.25
  set Output directory = @TEST_OUTPUT_DIR@/harmonic-simplex-22
  subsection Matrix
    set Initial refinement = 0
    set Dirichlet boundary ids =
    subsection Grid generation
      set Triangulation type = fullydistributed
      set Grid generator = @TEST_DATA_DIR@/tests/simplex_square.msh
    end
    subsection Material properties
      subsection default
        set Density = 2
        set Rayleigh alpha = 0.4
      end
    end
    subsection Functions
      subsection Right hand side
        set Function expression = 1;2
      end
    end
  end
  subsection Fiber
    set Initial refinement = 0
    set Dirichlet boundary ids =
    subsection Grid generation
      set Triangulation type = fullydistributed
      set Grid generator = @TEST_DATA_DIR@/tests/simplex_square.msh
    end
    subsection Material properties
      subsection default
        set Density = 3
        set Rayleigh alpha = 0.7
      end
    end
    subsection Functions
      subsection Right hand side
        set Function expression = 0;0
      end
    end
  end
end
