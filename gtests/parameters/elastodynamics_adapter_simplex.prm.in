include @IMMERSX_BINARY_DIR@/gtests/parameters/elastodynamics_simplex_problem.prm
subsection Elastodynamics
  subsection IDA
    subsection Running parameters
      set Initial step size = 0.0001
      set Maximum order of BDF = 2
    end
    subsection Error control
      set Absolute error tolerance = 1.e-10
      set Relative error tolerance = 1.e-10
    end
  end
end
