set dimension = 3
set space dimension = 3
subsection Immersed Problem
  set FE degree = 2
  set Initial refinement = 0
  set Output directory = @TEST_OUTPUT_DIR@/elasticity-simplex
  set Dirichlet boundary ids = 0
  subsection Grid generation
    set Domain type = file
    set Triangulation type = fullydistributed
    set Grid generator = @TEST_DATA_DIR@/tests/simplex_cube.msh
  end
  subsection Time parameters
    set Initial time = 0
    set Final time = 0
  end
  subsection Immersed inclusions
    set Inclusions =
    set Inclusions file =
  end
  subsection Material properties
    subsection default
      set Lame mu = 1
      set Lame lambda = 1
      set Density = 0
      set Viscosity eta = 0
      set Rayleigh alpha = 0
      set Rayleigh beta = 0
    end
  end
end
subsection Functions
  subsection Right hand side
    set Variable names = x,y,z,t
    set Function expression = -6; 0; 0
  end
  subsection Dirichlet boundary conditions
    set Variable names = x,y,z,t
    set Function expression = 1+x*x; 0; 0
  end
end
subsection Solvers
  subsection Displacement
    set Max steps = 1000
    set Tolerance = 1.e-13
    set Reduction = 1.e-13
  end
end
