# Validate and reuse the same compiled registry as the category coverage guard.
include("${CMAKE_CURRENT_LIST_DIR}/check_test_categories.cmake")

function(_quote_argument output value)
  set(_equals "=")
  while("${value}" MATCHES "\\]${_equals}\\]")
    string(APPEND _equals "=")
  endwhile()
  set(${output} "[${_equals}[${value}]${_equals}]" PARENT_SCOPE)
endfunction()

function(_register_group category mode filter suite)
  set(_name "${TEST_NAME_PREFIX}.${category}.${mode}")
  if(suite)
    string(APPEND _name ".${suite}")
  endif()
  set(_labels "${category}")
  set(_timeout 300)
  if(category STREQUAL "unit" OR category STREQUAL "integration")
    list(APPEND _labels quick)
  endif()
  if(category STREQUAL "integration")
    set(_timeout 600)
  elseif(category STREQUAL "validation" OR category STREQUAL "application")
    set(_timeout 1200)
  endif()
  if(suite)
    list(APPEND _labels "suite:${suite}")
  endif()

  string(MAKE_C_IDENTIFIER "${_name}" _filename)
  string(SHA256 _hash "${_name}")
  string(SUBSTRING "${_hash}" 0 8 _hash)
  set(_command "${CMAKE_COMMAND}" -E env "GTEST_FILTER=${filter}"
    "GTEST_OUTPUT=xml:${TEST_RESULTS_DIR}/${_filename}-${_hash}.xml")
  if(mode STREQUAL "MPI")
    if(NOT MPIEXEC)
      return()
    endif()
    list(APPEND _command "${MPIEXEC}" -np 2)
    list(APPEND _labels mpi)
  endif()
  list(APPEND _command "${TEST_EXECUTABLE}")

  _quote_argument(_quoted_name "${_name}")
  set(_line "add_test(${_quoted_name}")
  foreach(_argument IN LISTS _command)
    _quote_argument(_quoted "${_argument}")
    string(APPEND _line " ${_quoted}")
  endforeach()
  string(APPEND _line ")\n")
  _quote_argument(_quoted_labels "${_labels}")
  string(APPEND _line
    "set_tests_properties(${_quoted_name} PROPERTIES LABELS ${_quoted_labels} TIMEOUT ${_timeout} RESOURCE_LOCK ImmersX.TestOutput")
  if(mode STREQUAL "MPI")
    string(APPEND _line " PROCESSORS 2")
  endif()
  string(APPEND _line ")\n")
  file(APPEND "${OUTPUT_FILE}" "${_line}")
endfunction()

file(WRITE "${OUTPUT_FILE}" "# Generated from the compiled GoogleTest registry.\n")
file(MAKE_DIRECTORY "${TEST_RESULTS_DIR}")

# Collect actual suites and process modes. In particular, do not start MPI for
# suites containing only serial tests, or register empty typed-suite patterns.
set(_compiled_suites)
foreach(_line IN LISTS _lines)
  if(_line MATCHES "^([^ .]+)\\.[ ]*(#.*)?$")
    set(_suite "${CMAKE_MATCH_1}")
    list(APPEND _compiled_suites "${_suite}")
  elseif(_line MATCHES "^  ([^ #]+)")
    set(_case "${CMAKE_MATCH_1}")
    if(NOT _case MATCHES "^MPI_")
      set(_serial_${_suite} TRUE)
    endif()
    if(_case MATCHES "^(MPI_|BOTH_)")
      set(_mpi_${_suite} TRUE)
    endif()
  endif()
endforeach()

foreach(_category IN LISTS IMMERSX_TEST_PRIMARY_CATEGORIES)
  string(TOUPPER "${_category}" _upper)
  set(_serial_patterns)
  set(_mpi_patterns)
  foreach(_pattern IN LISTS IMMERSX_${_upper}_TEST_SUITES)
    # The coverage guard has already established a unique primary category.
    string(REGEX REPLACE "([][+.^$(){}|\\\\])" "\\\\\\1" _regex "${_pattern}")
    string(REPLACE "*" ".*" _regex "${_regex}")
    string(REPLACE "?" "." _regex "${_regex}")
    foreach(_suite IN LISTS _compiled_suites)
      if(_suite MATCHES "^${_regex}$")
        if(_category STREQUAL "integration")
          if(_serial_${_suite})
            _register_group("${_category}" Serial "${_suite}.*-*.MPI_*" "${_suite}")
          endif()
          if(_mpi_${_suite})
            _register_group("${_category}" MPI "${_suite}.MPI_*:${_suite}.BOTH_*" "${_suite}")
          endif()
        else()
          if(_serial_${_suite})
            list(APPEND _serial_patterns "${_suite}.*")
          endif()
          if(_mpi_${_suite})
            list(APPEND _mpi_patterns "${_suite}.MPI_*" "${_suite}.BOTH_*")
          endif()
        endif()
      endif()
    endforeach()
  endforeach()
  if(_serial_patterns)
    string(JOIN ":" _filter ${_serial_patterns})
    _register_group("${_category}" Serial "${_filter}-*.MPI_*" "")
  endif()
  if(_mpi_patterns)
    string(JOIN ":" _filter ${_mpi_patterns})
    _register_group("${_category}" MPI "${_filter}" "")
  endif()
endforeach()
