foreach(_required EXECUTABLE PARAMETERS OUTPUT_DIRECTORY CASE RANKS)
  if(NOT DEFINED ${_required})
    message(FATAL_ERROR "Missing ${_required}")
  endif()
endforeach()

# These are dedicated build-tree example outputs. Remove only this
# application's files so stale output cannot make a failed write pass.
file(GLOB _old_output
  "${OUTPUT_DIRECTORY}/lifted_elasticity_*.pvd"
  "${OUTPUT_DIRECTORY}/lifted_elasticity_*.vtu")
if(_old_output)
  file(REMOVE ${_old_output})
endif()
set(_mpi_command)
if(RANKS GREATER 1)
  set(_mpi_command "${MPIEXEC}" -np "${RANKS}")
endif()
execute_process(COMMAND ${_mpi_command} "${EXECUTABLE}" "${PARAMETERS}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr
  TIMEOUT 110)
message("${_stdout}${_stderr}")
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Static elasticity example failed: ${_result}")
endif()

set(_last_cycle 1)
if(CASE STREQUAL "pressure_radius_3d")
  set(_last_cycle 0)
endif()
set(_previous_cells 0)
foreach(_cycle RANGE 0 ${_last_cycle})
  if(NOT _stdout MATCHES "Static cycle ${_cycle}, residual ")
    message(FATAL_ERROR "Static cycle ${_cycle} was not executed")
  endif()
  set(_stems "lifted_elasticity_${_cycle}")
  if(NOT CASE STREQUAL "uncoupled_2d")
    list(APPEND _stems "lifted_elasticity_modes_${_cycle}")
  endif()
  foreach(_stem IN LISTS _stems)
    set(_pvd "${OUTPUT_DIRECTORY}/${_stem}.pvd")
    set(_vtu "${OUTPUT_DIRECTORY}/${_stem}_0.vtu")
    if(NOT EXISTS "${_pvd}" OR NOT EXISTS "${_vtu}")
      message(FATAL_ERROR "Missing static output '${_stem}'")
    endif()
    file(READ "${_pvd}" _record)
    if(NOT _record MATCHES "timestep=\"${_cycle}(\\.0*)?\"")
      message(FATAL_ERROR "Wrong cycle in '${_pvd}'")
    endif()
    file(READ "${_vtu}" _data)
    set(_fields displacement)
    if(_stem MATCHES "_modes_")
      set(_fields multiplier_0 multiplier_1 multiplier_2)
    endif()
    foreach(_field IN LISTS _fields)
      if(NOT _data MATCHES "Name=\"${_field}\"")
        message(FATAL_ERROR "Missing field '${_field}' in '${_vtu}'")
      endif()
    endforeach()
    if(NOT _stem MATCHES "_modes_")
      string(REGEX MATCHALL "NumberOfCells=\"[0-9]+\"" _pieces "${_data}")
      set(_cells 0)
      foreach(_piece IN LISTS _pieces)
        string(REGEX MATCH "[0-9]+" _count "${_piece}")
        math(EXPR _cells "${_cells} + ${_count}")
      endforeach()
      if(NOT _cells GREATER _previous_cells)
        message(FATAL_ERROR "The bulk mesh did not refine in cycle ${_cycle}")
      endif()
      set(_previous_cells "${_cells}")
    endif()
  endforeach()
endforeach()
file(GLOB _records "${OUTPUT_DIRECTORY}/lifted_elasticity_*.pvd")
list(FILTER _records INCLUDE REGEX "/lifted_elasticity_(modes_)?[0-9]+\\.pvd$")
list(LENGTH _records _count)
math(EXPR _expected "${_last_cycle} + 1")
if(NOT CASE STREQUAL "uncoupled_2d")
  math(EXPR _expected "2 * ${_expected}")
endif()
if(NOT _count EQUAL _expected)
  message(FATAL_ERROR "Expected ${_expected} cycle/field records, found ${_count}")
endif()
