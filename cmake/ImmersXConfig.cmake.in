@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(deal.II 9.7.1)

if(@OpenMP_CXX_FOUND@)
  find_dependency(OpenMP)
endif()

set(ImmersX_WITH_METRIC_FLOW_X @IMMERSX_WITH_METRIC_FLOW_X@)
if(ImmersX_WITH_METRIC_FLOW_X)
  find_dependency(MetricFlowX CONFIG)
endif()

set(ImmersX_WITH_CORAL @IMMERSX_WITH_CORAL@)
if(ImmersX_WITH_CORAL)
  set(ImmersX_CORAL_PLUGIN_DIR
      "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/immersx/coral")
endif()

if(@IMMERSX_BUILD_BOTH_VARIANTS@)
  # A DebugRelease build exports both concrete libraries with the build tree's
  # single configuration. Map ordinary downstream single-config builds to
  # that imported configuration; ImmersX::immersx then selects the matching
  # library.
  set(CMAKE_MAP_IMPORTED_CONFIG_DEBUG DebugRelease)
  set(CMAKE_MAP_IMPORTED_CONFIG_RELEASE DebugRelease)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ImmersXTargets.cmake")

set(ImmersX_VERSION "@PROJECT_VERSION@")
set(ImmersX_DATA_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/immersx")
set(ImmersX_TEST_DATA_DIR "${ImmersX_DATA_DIR}/tests")

check_required_components(ImmersX)
