if(NOT DEFINED WORKING_DIRECTORY OR NOT IS_ABSOLUTE "${WORKING_DIRECTORY}")
  message(FATAL_ERROR "Provide an absolute test working directory.")
endif()
set(_output "${WORKING_DIRECTORY}/output")
file(REMOVE_RECURSE "${_output}")
file(READ "${PARAMETERS}" _parameters)
string(REGEX REPLACE "set Output directory[ \t]*=[^\n]*"
  "set Output directory = ${_output}" _parameters "${_parameters}")
string(REGEX REPLACE "set dimension[ \t]*=[^\n]*"
  "set dimension = ${DIM}" _parameters "${_parameters}")
string(REGEX REPLACE "set space dimension[ \t]*=[^\n]*"
  "set space dimension = ${SPACEDIM}" _parameters "${_parameters}")
string(REPLACE "set Formulation = independent" "set Formulation = ${FORMULATION}"
  _parameters "${_parameters}")
set(_zero "0")
set(_traction "1")
if(SPACEDIM GREATER 1)
  foreach(_component RANGE 2 ${SPACEDIM})
    string(APPEND _zero "; 0")
    string(APPEND _traction "; 0")
  endforeach()
endif()
string(REPLACE "set Function expression = 0; 0" "set Function expression = ${_zero}"
  _parameters "${_parameters}")
string(REPLACE "set Function expression = 1; 0" "set Function expression = ${_traction}"
  _parameters "${_parameters}")
if(DIM EQUAL SPACEDIM)
  string(REPLACE "  subsection Lift\n    set Thickness = 0.1\n  end\n\n" ""
    _parameters "${_parameters}")
endif()
file(WRITE "${WORKING_DIRECTORY}/parameters.prm" "${_parameters}")
set(_command "${EXECUTABLE}" "${WORKING_DIRECTORY}/parameters.prm")
if(RANKS GREATER 1)
  list(PREPEND _command "${MPIEXEC}" -np "${RANKS}")
endif()
execute_process(COMMAND ${_command} WORKING_DIRECTORY "${WORKING_DIRECTORY}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Harmonic reinforcement tutorial failed (${_result}):\n${_stdout}\n${_stderr}")
endif()
if(NOT EXISTS "${_output}/frequencies.csv")
  message(FATAL_ERROR "The frequency metadata was not written.")
endif()
file(STRINGS "${_output}/frequencies.csv" _frequencies)
list(LENGTH _frequencies _rows)
if(NOT _rows EQUAL 4)
  message(FATAL_ERROR "Expected one header and three frequency records, got ${_rows}.")
endif()
set(_problems matrix)
if(FORMULATION STREQUAL "independent")
  list(APPEND _problems fiber)
endif()
foreach(_problem IN LISTS _problems)
  file(GLOB _datasets "${_output}/${_problem}/*.pvtu")
  list(LENGTH _datasets _count)
  if(NOT _count EQUAL 3)
    message(FATAL_ERROR "Expected three ${_problem} datasets, got ${_count}.")
  endif()
endforeach()
if(FORMULATION STREQUAL "independent")
  foreach(_part real imaginary)
    file(GLOB _datasets "${_output}/interaction/frequency_*/lambda_${_part}.pvd")
    list(LENGTH _datasets _count)
    if(NOT _count EQUAL 3)
      message(FATAL_ERROR "Expected three ${_part} multiplier datasets, got ${_count}.")
    endif()
  endforeach()
elseif(FORMULATION STREQUAL "shared")
  file(GLOB _independent_datasets "${_output}/fiber/*.pvtu" "${_output}/interaction/frequency_*/*.pvd")
  if(_independent_datasets)
    message(FATAL_ERROR "Shared displacement must not write independent fiber or multiplier datasets.")
  endif()
endif()
