# Draft coupled input with synthetic material, outlet and inflow data.
# This application generates a new network on the final solid background.
# It does not load the archive produced by generate.prm.
include @IMMERSX_BINARY_DIR@/tutorials/cco_sphere/cco.prm

subsection Elastodynamics
  set FE degree = 1
  set Number of refinement cycles = 1
  set Dirichlet boundary ids = 0
  set Output directory = @IMMERSX_BINARY_DIR@/tutorial-output/cco-sphere/coupled
  set Output name = solid
  subsection Domain
    set Grid generator = hyper_ball
    set Grid generator arguments = 0,0,0:1:false
    set Grid scale = 1
    set Initial refinement = 1
    set Triangulation type = distributed
  end
  subsection Material properties
    subsection default
      set Density = 1060
      set Lame mu = 1e6
      set Lame lambda = 1e6
      set Rayleigh alpha = 0
      set Rayleigh beta = 0
      set Viscosity eta = 0
    end
  end
  subsection Functions
    subsection Body force
      set Function expression = 0;0;0
    end
    subsection Displacement boundary
      set Function expression = 0;0;0
    end
    subsection Velocity boundary
      set Function expression = 0;0;0
    end
    subsection Initial displacement
      set Function expression = 0;0;0
    end
    subsection Initial velocity
      set Function expression = 0;0;0
    end
  end
end

subsection Metric Flow Parameters
  set Density (rho) = 1060
  set Reflection coefficient at outflow boundary (Rt) = 0
  set Tube law exponent (m) = 0.5
  set Viscosity coefficient (mu) = 0
  set Profile constant for friction term (xi) = 0
end

subsection Functions
  # Q(0)=Q'(0)=0 matches the initially resting solid and flow.
  set Inflow function = 5e-8*(1-cos(314.1592653589793*t))
end

subsection MetricFlowSystem<1, 3>
  set Finite element degree = 1
  set Number of global refinement = 0
  set Number of refinement cycles = 1
  set Wall model = Square root
  set Initial state source = rest
  set Initial consistency tolerance = 1e-5
  set Output filename = flow
  set Output directory = @IMMERSX_BINARY_DIR@/tutorial-output/cco-sphere/coupled
  set Use direct solver = true
  set Verbosity (console depth) = 0
  set Numerical flux type = HLL
  set Outlet boundary condition type = RCR
  subsection IDA parameters
    set Initial time = 0
    set Final time = 0.002
    set Time interval between each output = 0.001
    subsection Running parameters
      set Initial step size = 0.0001
      set Minimum step size = 1e-8
      set Maximum order of BDF = 2
      set Maximum number of nonlinear iterations = 30
    end
    subsection Error control
      set Absolute error tolerance = 1e-6
      set Relative error tolerance = 1e-5
    end
    subsection Linear solver
      set Type = iterative
    end
  end
end

subsection MetricFlowX coupling
  set Embedded partitioning policy = default
  set Generate vascular network = true
  set Generated vessel Young modulus = 5e5
  set Generated vessel wall thickness = 0.0003
  set Generated vessel reference pressure = 125
  set Generated terminal resistance = 1e8
  set Generated outlet pressure = 125
end

subsection MetricFlowX multiplier space
  set Finite element = auto
end

subsection MetricFlowX vessel wall lift
  subsection Cross section
    set Refinement level = 1
    set Inclusion type = hyper_ball
    set Maximum inclusion degree = 1
    set Selected indices = 3, 7
    set Quadrature type = gauss
    set Number of points = 8
  end
  subsection Representative quadrature
    set Type = gauss
    set Number of points = 2
  end
end
