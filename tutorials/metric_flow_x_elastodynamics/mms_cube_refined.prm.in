# Reuse the same target and forcing on uniformly refined solid and centerline meshes.
include @IMMERSX_BINARY_DIR@/tutorials/metric_flow_x_elastodynamics/mms_cube.prm

subsection Elastodynamics
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-refined-resolved
  subsection Domain
    set Grid generator arguments = 8, 32, 32: -0.120685, -0.120685, -0.120685: 0.120685, 0.120685, 0.120685: false
  end
end

subsection MetricFlowSystem<1, 3>
  set Number of global refinement = 2
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-refined-resolved
end

subsection MetricFlowX vessel wall lift
  subsection Cross section
    set Refinement level = 3
  end
end
