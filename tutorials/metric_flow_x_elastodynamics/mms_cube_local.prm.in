# Physical-support bidirectional co-refinement from one solid and one fluid cell.
include @IMMERSX_BINARY_DIR@/tutorials/metric_flow_x_elastodynamics/mms_cube.prm

subsection Elastodynamics
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-local
  subsection Domain
    set Grid generator arguments = 1, 1, 1: -0.120685, -0.120685, -0.120685: 0.120685, 0.120685, 0.120685: false
    set Initial refinement = 0
  end
end
subsection MetricFlowSystem<1, 3>
  set Number of global refinement = 0
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-local
end
subsection MetricFlowX vessel wall lift
  subsection Cross section
    set Refinement level = 0
    set Number of points = 2
  end
end
subsection MetricFlowX coupling
  subsection Co-refinement
    set Enabled = true
    set Refinement strategy = both
    set Lower factor = 0.25
    set Upper factor = 4
    set Max refinement level = 8
    set Max section refinement level = 6
    set Space pre-refinement cycles = 0
    set Embedded pre-refinement cycles = 0
    set Space post-refinement cycles = 0
    set Embedded post-refinement cycles = 0
  end
end
