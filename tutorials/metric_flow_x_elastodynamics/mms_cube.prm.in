# Nonzero stress-jump manufactured solution with volume supplied by the inlet.
# See doc/tutorials/metric-flow-x-elastodynamics-mms.md for the derivation.
# Target: g=t^3, A=A0*(1+g)^2, lambda=-6*g, rho_s=mu_s=lambda_s=1.

subsection Elastodynamics
  set FE degree = 1
  set Number of refinement cycles = 1
  set Dirichlet boundary ids = 0
  set Neumann boundary ids =
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-resolved
  set Output name = solid
  subsection Domain
    set Initial refinement = 0
    set Grid generator = subdivided_hyper_rectangle
    set Grid generator arguments = 4, 16, 16: -0.120685, -0.120685, -0.120685: 0.120685, 0.120685, 0.120685: false
    set Triangulation type = distributed
  end
  subsection Material properties
    subsection default
      set Density = 1
      set Lame mu = 1
      set Lame lambda = 1
      set Rayleigh alpha = 0
      set Rayleigh beta = 0
      set Viscosity eta = 0
    end
  end
  subsection Functions
    # max(r^2,R2) gives the interior/exterior branches without dividing by zero.
    # R2=A0/pi for the existing single_vessel_centered.vtk input.
    subsection Body force
      set Function constants = R2=9.7418740666549138e-5
      set Function expression = 0; 6*t*y*R2/max(y^2+z^2,R2); 6*t*z*R2/max(y^2+z^2,R2)
    end
    subsection Displacement boundary
      set Function constants = R2=9.7418740666549138e-5
      set Function expression = 0; t^3*y*R2/max(y^2+z^2,R2); t^3*z*R2/max(y^2+z^2,R2)
    end
    subsection Velocity boundary
      set Function constants = R2=9.7418740666549138e-5
      set Function expression = 0; 3*t^2*y*R2/max(y^2+z^2,R2); 3*t^2*z*R2/max(y^2+z^2,R2)
    end
    subsection Initial displacement
      set Function expression = 0; 0; 0
    end
    subsection Initial velocity
      set Function expression = 0; 0; 0
    end
    subsection Exact solution
      # Stored for reference; this coupled executable does not call compute_error().
      set Function constants = R2=9.7418740666549138e-5
      set Function expression = 0; t^3*y*R2/max(y^2+z^2,R2); t^3*z*R2/max(y^2+z^2,R2)
    end
  end
end

subsection Metric Flow Parameters
  set Density (rho) = 1060
  set Reflection coefficient at outflow boundary (Rt) = 1
  set Tube law exponent (m) = 0.5
  set Viscosity coefficient (mu) = 0
  set Profile constant for friction term (xi) = 0
end

subsection Functions
  # Q_in=L*dA/dt supplies the entire increase in vessel volume; Q_out=0.
  set Inflow function = 0.24137*6*3.0605e-4*t^2*(1+t^3)
  # Source-free physical continuity: A_t+(A*U)_x=0.
  # The second component balances U_t+U*U_x; total pressure is uniform in x.
  set RHS expression = 0; (0.120685-x)*(12*t-42*t^4)/(1+t^3)^2
  set Exact solution = 3.0605e-4*(1+t^3)^2; (0.120685-x)*6*t^2/(1+t^3); 3.0605e-4*(1+t^3)^2; (0.120685-x)*6*t^2/(1+t^3)
end

subsection MetricFlowSystem<1, 3>
  subsection IDA parameters
    set Initial time = 0
    set Final time = 0.1
    set Time interval between each output = 0.05
    subsection Running parameters
      set Initial step size = 1e-4
      set Minimum step size = 1e-10
      set Maximum order of BDF = 2
      set Maximum number of nonlinear iterations = 12
    end
    subsection Error control
      set Absolute error tolerance = 1e-9
      set Relative error tolerance = 1e-7
    end
  end
  set Finite element degree = 1
  # Refine the single coarse cell into two cells, each spanning two solid axial cells.
  set Number of global refinement = 1
  set Number of refinement cycles = 1
  set Output filename = flow
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-resolved
  set Use direct solver = true
  set Verbosity (console depth) = 0
  set Numerical flux type = HLL
  set Outlet boundary condition type = Reflection
  set Vtk file path for mesh input = @TEST_DATA_DIR@/metric_flow_x/single_vessel_centered.vtk
end

subsection MetricFlowX multiplier space
  set Finite element = auto
end

subsection MetricFlowX vessel wall lift
  subsection Cross section
    set Refinement level = 2
    set Inclusion type = hyper_ball
    set Maximum inclusion degree = 1
    set Selected indices = 3, 7
    set Quadrature type = gauss
    set Number of points = 4
  end
  subsection Representative quadrature
    set Type = gauss
    set Number of points = 4
    set Number of repetitions = 2
  end
end
