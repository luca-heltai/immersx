# Time-tolerance check at fixed local base mesh and output stops.
include @IMMERSX_BINARY_DIR@/tutorials/metric_flow_x_elastodynamics/mms_cube_local.prm
subsection Elastodynamics
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-local-tight
end
subsection MetricFlowSystem<1, 3>
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-local-tight
  subsection IDA parameters
    subsection Error control
      set Absolute error tolerance = 1e-10
      set Relative error tolerance = 1e-8
    end
  end
end
