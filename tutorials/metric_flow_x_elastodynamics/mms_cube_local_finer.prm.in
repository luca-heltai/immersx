# Two additional local passes, retaining the same continuum target and tolerances.
include @IMMERSX_BINARY_DIR@/tutorials/metric_flow_x_elastodynamics/mms_cube_local_refined.prm

subsection Elastodynamics
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-local-finer
end
subsection MetricFlowSystem<1, 3>
  set Number of global refinement = 2
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-local-finer
  subsection IDA parameters
    subsection Linear solver
      set Type = iterative
    end
  end
end
subsection MetricFlowX vessel wall lift
  subsection Cross section
    set Refinement level = 4
  end
end
subsection MetricFlowX coupling
  subsection Co-refinement
    set Space post-refinement cycles = 2
  end
end
