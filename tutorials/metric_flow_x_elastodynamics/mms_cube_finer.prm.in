# Third spatial level; the continuum target and tolerances are unchanged.
include @IMMERSX_BINARY_DIR@/tutorials/metric_flow_x_elastodynamics/mms_cube_refined.prm

subsection Elastodynamics
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-finer-resolved
  subsection Domain
    set Grid generator arguments = 16, 64, 64: -0.120685, -0.120685, -0.120685: 0.120685, 0.120685, 0.120685: false
  end
end
subsection MetricFlowSystem<1, 3>
  subsection IDA parameters
    subsection Linear solver
      set Type = iterative
    end
  end
  set Number of global refinement = 2
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-mms-cube-finer-resolved
end
subsection MetricFlowX vessel wall lift
  subsection Cross section
    set Refinement level = 4
  end
end
