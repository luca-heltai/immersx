# Existing IRCAD11 small tissue and three grown physical networks, SI units.
subsection Elastic static
  set FE degree = 2
  set Dirichlet boundary ids =
  set Robin boundary ids = 1
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-elastostatic-ircad11-small
  set Output name = solid
  subsection Domain
    set Grid generator = @TEST_DATA_DIR@/ircad11-small/small.msh
    set Initial refinement = 0
    set Triangulation type = fullydistributed
    subsection Surface mesh
      set Input = volume
    end
  end
  subsection Refinement
    set Number of refinement cycles = 1
  end
  subsection Material properties
    subsection default
      set Density = 0
      set Viscosity eta = 0
      set Rayleigh alpha = 0
      set Rayleigh beta = 0
      set Lame mu = 2013.4228187919464
      set Lame lambda = 98657.7181208053
    end
  end
  subsection Functions
    subsection Right hand side
      set Variable names = x,y,z,t
      set Function expression = 0;0;0
    end
    subsection Robin coefficient
      set Function expression = 100000
    end
    subsection Robin boundary conditions
      set Function expression = 0;0;0
    end
  end
end
subsection Metric Flow Parameters
  set Density (rho) = 1060
  set Reflection coefficient at outflow boundary (Rt) = 0
  set Tube law exponent (m) = .5
  set Viscosity coefficient (mu) = .00371
  set Profile constant for friction term (xi) = 2
end
subsection Functions
  # Smooth startup at the case-11 illustrative arterial scale; no MOX replay.
  set Inflow function = 6.08461327615316e-10*(1-cos(314.1592653589793*t))
end
subsection MetricFlowSystem<1, 3>
  set Finite element degree = 2
  set Number of global refinement = 0
  set Number of refinement cycles = 1
  set Output filename = flow
  set Output directory = @TEST_OUTPUT_DIR@/metric-flow-x-elastostatic-ircad11-small
  set Use direct solver = true
  set Verbosity (console depth) = 0
  set Numerical flux type = HLL
  set Initial state source = rest
  set Use componentwise absolute tolerances = true
  set Area absolute tolerance fraction = 1e-3
  set Velocity absolute tolerance = 1e-7
  set Capacitor pressure absolute tolerance = 1
  set Outlet boundary condition type = RCR
  subsection IDA parameters
    set Initial time = 0
    set Final time = .002
    set Time interval between each output = .001
    subsection Initial condition correction parameters
      set Correction type at initial time = use_y_diff
    end
    subsection Running parameters
      set Initial step size = .0001
      set Minimum step size = 1e-8
      set Maximum order of BDF = 2
      set Maximum number of nonlinear iterations = 8
    end
    subsection Error control
      set Absolute error tolerance = 1e-9
      set Relative error tolerance = 1e-7
    end
  end
end
subsection MetricFlowX multiplier space
  set Finite element = auto
end
subsection MetricFlowX vessel wall lift
  set Thickness = .001
  subsection Cross section
    set Refinement level = 1
    set Geometry type = hyper_ball
    set Maximum basis degree = 1
    set Selected modes = 3, 7
    set Quadrature type = gauss
    set Number of points = 3
  end
  subsection Representative quadrature
    set Type = gauss
    set Number of points = 3
  end
end
subsection MetricFlowX coupling
  set Pressure feedback = true
  set Use native flow tolerances = true
  set Setup only = false
  set Flow block solver = mumps
  set MUMPS workspace relaxation = 200
  set Stop at output times = true
  set Wall pressure absolute tolerance = 1e-7
  subsection Archived network
    set Directory = @TEST_DATA_DIR@/ircad11-small/network
    # Role order: arterial, venous, portal.
    set Young moduli = 400000,400000,400000
    set Wall thickness ratios = .1,.1,.1
    set Reference pressures = 10064.536060032478,629.59739556,1066.57909932
    set Portal pressure = 1066.57909932
    set Venous pressure = 629.59739556
    set Root resistance = 100000
    set Sealed input terminal ids = 33,51,100,141,190,197,232,272,276,294,295,315,327,348,368,396,432,453,494,501,513,521,546,555,561,568,578,613,626,630,635,640,695,733,831,847,848,889,901,961,1030,1034,1038,1047,1051,1056,1061,1064,1085,1102,1119,1163,1164
    subsection Discretization
      set Target length factor = 1
      set Lower length factor = .5
      set Upper length factor = 2
      set Exterior target length = 0
      set Numerical cell budget = 1000000
    end
  end
  subsection Co-refinement
    set Enabled = false
  end
  subsection Particle output
    set Properties = lifted_value, weight
  end
end
