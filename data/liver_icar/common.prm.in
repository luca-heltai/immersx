# SI units. This composite example is not calibrated to the IRCAD subject.
subsection Elastodynamics
  set FE degree = 2
  set Number of refinement cycles = 1
  set Dirichlet boundary ids =
  set Neumann boundary ids =
  set Robin boundary ids = 0
  set Output name = solid
  subsection Domain
    set Initial refinement = 0
    set Grid generator = @TEST_DATA_DIR@/liver_icar/assets/meshes/small.msh
    set Triangulation type = fullydistributed
    subsection Surface mesh
      set Input = volume
    end
  end
  subsection Material properties
    subsection default
      set Density = 1060
      set Lame mu = 2013.4228187919464
      set Lame lambda = 98657.7181208053
      set Rayleigh alpha = 0
      set Rayleigh beta = 0
      # Twice the conditional shear viscosity 2.1 Pa s; see the README.
      set Viscosity eta = 4.2
    end
  end
  subsection Functions
    subsection Body force
      set Function expression = 0;0;0
    end
    subsection Robin coefficient
      set Function expression = 100000
    end
    subsection Robin boundary
      set Function expression = 0;0;0
    end
    subsection Initial displacement
      set Function expression = 0;0;0
    end
    subsection Initial velocity
      set Function expression = 0;0;0
    end
  end
end

subsection Metric Flow Parameters
  set Density (rho) = 1060
  set Reflection coefficient at outflow boundary (Rt) = 0
  set Tube law exponent (m) = .5
  set Viscosity coefficient (mu) = .00371
  set Profile constant for friction term (xi) = 2
end

subsection MetricFlowSystem<1, 3>
  set Finite element degree = 1
  set Number of global refinement = 0
  set Number of refinement cycles = 1
  set Output filename = flow
  set Output terminal CSV file = terminals.csv
  set Output mass conservation CSV file = mass_conservation.csv
  set Output IDA statistics CSV file =
  set Output IDA step history CSV file =
  set Use direct solver = true
  set Verbosity (console depth) = 0
  set Numerical flux type = HLL
  set Outlet boundary condition type = RCR
  # Archive input bypasses the VTK reader; this file is intentionally absent.
  set Vtk file path for mesh input = @TEST_DATA_DIR@/liver_icar/assets/unused.vtk
  set Inflow CSV file = @TEST_DATA_DIR@/liver_icar/assets/inputs/inlet_ha.csv
  set Inflow CSV period = 0
  set Initial state source = rest
  set Wall model = Square root
  set Use componentwise absolute tolerances = true
  set Area absolute tolerance fraction = 1e-5
  set Velocity absolute tolerance = 1e-6
  set Capacitor pressure absolute tolerance = .01
  subsection IDA parameters
    set Initial time = 7.2
    set Final time = 8
    set Time interval between each output = .01
    set Print current statistics = true
    subsection Running parameters
      set Initial step size = .001
      set Minimum step size = 1e-10
      set Maximum order of BDF = 2
      set Maximum number of nonlinear iterations = 20
    end
    subsection Nonlinear solver
      set Convergence coefficient = 1e-4
    end
    subsection Initial condition correction parameters
      set Correction type at initial time = use_y_dot
      set Maximum number of nonlinear iterations = 50
    end
    subsection Error control
      set Absolute error tolerance = 1e-7
      set Relative error tolerance = 1e-4
      set Ignore algebraic terms for error computations = true
    end
  end
end

subsection MetricFlowX multiplier space
  set Finite element = auto
end
subsection MetricFlowX vessel wall lift
  set Thickness = .01
  set Constant thickness = .01
  subsection Cross section
    set Refinement level = 1
    set Inclusion type = hyper_ball
    set Maximum inclusion degree = 1
    set Selected indices = 3, 7
    set Quadrature type = gauss
    set Number of points = 3
  end
  subsection Representative quadrature
    set Type = gauss
    set Number of points = 3
  end
end
subsection MetricFlowX coupling
  set Use native flow tolerances = true
  set Stop at output times = true
  set Displacement absolute tolerance = 1e-8
  set Velocity absolute tolerance = 1e-6
  set Wall pressure absolute tolerance = .01
  subsection Archived network
    set Directory = @TEST_DATA_DIR@/liver_icar/assets/network
    set Young moduli = 400000,400000,400000
    set Wall thickness ratios = .1,.1,.1
    # Role order is arterial, hepatic venous, portal.
    set Reference pressures = 10064.536060032478,629.59739556,1066.57909932
    set Portal pressure = 1066.57909932
    set Venous pressure = 629.59739556
    set Root resistance = 100000
  end
end
subsection Vascularization
  subsection Discretization
    set Target length factor = 1
    set Lower length factor = .5
    set Upper length factor = 2
  end
end
