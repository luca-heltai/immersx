include @TEST_DATA_DIR@/liver_icar/generate.prm

subsection Liver
  set Output directory = @TEST_OUTPUT_DIR@/liver_icar/mesh-small
  set Only generate mesh = true
  subsection Domain
    set Grid generator = @TEST_DATA_DIR@/liver_icar/assets/inputs/liver.stl
    subsection Surface mesh
      set Input = surface
      set Target edge length = .012
    end
  end
end
