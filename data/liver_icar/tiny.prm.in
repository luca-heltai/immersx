include @TEST_DATA_DIR@/liver_icar/common.prm

subsection Elastodynamics
  set FE degree = 1
  set Output directory = @TEST_OUTPUT_DIR@/liver_icar/tiny/solid
  subsection Domain
    set Grid generator = @TEST_DATA_DIR@/liver_icar/assets/meshes/small.msh
  end
end
subsection MetricFlowSystem<1, 3>
  set Finite element degree = 0
  set Output directory = @TEST_OUTPUT_DIR@/liver_icar/tiny/flow
  subsection IDA parameters
    subsection Linear solver
      set Type = umfpack
    end
  end
end
