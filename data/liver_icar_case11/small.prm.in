include @TEST_DATA_DIR@/liver_icar_case11/common.prm
subsection Elastodynamics
  set FE degree = 2
  set Output directory = @TEST_OUTPUT_DIR@/liver_icar_case11/small/solid
  subsection Domain
    set Grid generator = @TEST_DATA_DIR@/liver_icar_case11/assets/meshes/small.msh
  end
end
subsection MetricFlowSystem<1, 3>
  set Finite element degree = 2
  set Output directory = @TEST_OUTPUT_DIR@/liver_icar_case11/small/flow
  subsection IDA parameters
    subsection Linear solver
      set Type = mumps
    end
  end
end
subsection MetricFlowX coupling
  set Setup only = false
end
