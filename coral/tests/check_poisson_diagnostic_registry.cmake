# Check the actual port indices as emitted by Coral, not argument positions assumed by the UI.
string(JSON _diagnostic_registry_size LENGTH "${_registry}")
math(EXPR _diagnostic_registry_last "${_diagnostic_registry_size} - 1")
set(_diagnostic_count 0)
foreach(_index RANGE 0 ${_diagnostic_registry_last})
  string(JSON _key MEMBER "${_registry}" ${_index})
  if(NOT _key MATCHES "^ImmersX::Poisson<.*>::solution_(l2_norm|is_finite)::std::function<")
    continue()
  endif()
  set(_diagnostic "${CMAKE_MATCH_1}")
  if(_diagnostic STREQUAL "l2_norm")
    set(_output_name "norm")
    set(_output_type "double")
  elseif(_diagnostic STREQUAL "is_finite")
    set(_output_name "is_finite")
    set(_output_type "bool")
  endif()
  string(REGEX REPLACE "::solution_.*" "" _problem_type "${_key}")
  string(JSON _input_count LENGTH "${_registry}" "${_key}" inputs)
  string(JSON _output_count LENGTH "${_registry}" "${_key}" outputs)
  if(NOT _input_count EQUAL 1 OR NOT _output_count EQUAL 1)
    message(FATAL_ERROR "${_key}: expected one input and one output")
  endif()
  string(JSON _input GET "${_registry}" "${_key}" inputs 0)
  string(JSON _output GET "${_registry}" "${_key}" outputs 0)
  foreach(_field name type)
    string(JSON _actual_input GET "${_registry}" "${_key}" arguments ${_input} ${_field})
    string(JSON _actual_output GET "${_registry}" "${_key}" arguments ${_output} ${_field})
    if(_field STREQUAL "name")
      set(_expected_input "problem")
      set(_expected_output "${_output_name}")
    elseif(_field STREQUAL "type")
      set(_expected_input "${_problem_type}")
      set(_expected_output "${_output_type}")
    endif()
    if(NOT _actual_input STREQUAL _expected_input OR NOT _actual_output STREQUAL _expected_output)
      message(FATAL_ERROR "${_key}: incorrect diagnostic port ${_field}: input '${_actual_input}', output '${_actual_output}'")
    endif()
  endforeach()
  math(EXPR _diagnostic_count "${_diagnostic_count} + 1")
endforeach()
math(EXPR _expected_diagnostic_count "2 * ${SPACEDIM}")
if(NOT _diagnostic_count EQUAL _expected_diagnostic_count)
  message(FATAL_ERROR "Expected ${_expected_diagnostic_count} Poisson diagnostics, found ${_diagnostic_count}")
endif()
